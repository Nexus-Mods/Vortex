{
  "name": "prepare-nexusmods-release-action",
  "private": true,
  "version": "0.0.0",
  "description": "GitHub Action: prepare a stable Vortex GitHub release for upload to Nexus Mods - validate it, download the installer, and build the changelog from CHANGELOG.md.",
  "main": "src/index.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prebuild": "tsc --noEmit",
    "build": "ncc build src/index.ts -o dist --license LICENSES.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
