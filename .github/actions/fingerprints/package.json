{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@vortex/fingerprints-action",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "GitHub Action: collect fingerprints from PR body / release tag / manual input and write to vortex.resolved_fingerprints in ClickHouse.",
  "scripts": {
    "build": "node ./build.mjs",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm tsc",
    "lint": "pnpm exec oxlint --quiet",
    "lint:verbose": "pnpm exec oxlint"
  },
  "dependencies": {
    "@actions/core": "catalog:",
    "@actions/github": "catalog:",
    "@clickhouse/client": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
