{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@vortex/upgrade-electron-action",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "GitHub Action: upgrade Electron within its major and keep the pinned Node.js equal to the one Electron bundles.",
  "scripts": {
    "build": "node ./build.mjs",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm tsc",
    "lint": "pnpm exec oxlint --quiet",
    "lint:verbose": "pnpm exec oxlint"
  },
  "dependencies": {
    "@actions/core": "catalog:",
    "semver": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
