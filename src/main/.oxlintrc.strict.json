{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../oxlint.base.config.json", "../../oxlint.strict.config.json"],
  "rules": {
    "vitest/require-mock-type-parameters": "warn",
    "unicorn/require-post-message-target-origin": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "bluebird",
            "message": "Bluebird is being removed. Use native promises."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true,
    "node": true
  }
}
