{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.strict.json"],
  "rules": {
    "import/default": "warn",
    "import/no-empty-named-blocks": "warn",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "import/no-unassigned-import": "warn",
    "jsdoc/check-tag-names": "warn",
    "jsdoc/require-property-type": "warn",
    "jsdoc/require-yields": "warn",
    "no-extra-boolean-cast": "warn",
    "no-new": "warn",
    "no-prototype-builtins": "warn",
    "no-shadow": "warn",
    "no-underscore-dangle": "warn",
    "no-unmodified-loop-condition": "warn",
    "no-unneeded-ternary": "warn",
    "no-unreachable": "warn",
    "no-unused-expressions": "warn",
    "no-unused-vars": "warn",
    "no-useless-catch": "warn",
    "no-useless-concat": "warn",
    "no-useless-constructor": "warn",
    "no-useless-escape": "warn",
    "no-var": "warn",
    "oxc/only-used-in-recursion": "warn",
    "prefer-const": "warn",
    "prefer-rest-params": "warn",
    "prefer-spread": "warn",
    "promise/always-return": "warn",
    "promise/no-callback-in-promise": "warn",
    "promise/no-multiple-resolved": "warn",
    "promise/no-promise-in-callback": "warn",
    "promise/valid-params": "warn",
    "react/exhaustive-deps": "warn",
    "react/iframe-missing-sandbox": "warn",
    "react/jsx-key": "warn",
    "react/jsx-no-comment-textnodes": "warn",
    "react/no-did-update-set-state": "warn",
    "react/no-find-dom-node": "warn",
    "react/no-unsafe": "warn",
    "react/no-unstable-nested-components": "warn",
    "typescript/await-thenable": "warn",
    "typescript/consistent-return": "warn",
    "typescript/no-duplicate-type-constituents": "warn",
    "typescript/no-empty-object-type": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extraneous-class": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/no-meaningless-void-operator": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/no-non-null-asserted-optional-chain": "warn",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/no-require-imports": "warn",
    "typescript/no-this-alias": "warn",
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    "typescript/no-unnecessary-template-expression": "warn",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/no-unnecessary-type-parameters": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-enum-comparison": "warn",
    "typescript/no-unsafe-function-type": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/no-useless-default-assignment": "warn",
    "typescript/only-throw-error": "warn",
    "typescript/prefer-promise-reject-errors": "warn",
    "typescript/require-array-sort-compare": "warn",
    "typescript/require-await": "warn",
    "typescript/restrict-plus-operands": "warn",
    "typescript/restrict-template-expressions": "warn",
    "typescript/unbound-method": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/no-array-fill-with-reference-type": "warn",
    "unicorn/no-array-reverse": "warn",
    "unicorn/no-array-sort": "warn",
    "unicorn/no-empty-file": "warn",
    "unicorn/no-instanceof-builtins": "warn",
    "unicorn/no-new-array": "warn",
    "unicorn/no-thenable": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/prefer-add-event-listener": "warn",
    "unicorn/require-module-specifiers": "warn",
    "vitest/expect-expect": "warn",
    "vitest/no-commented-out-tests": "warn",
    "vitest/no-conditional-expect": "warn",
    "vitest/no-conditional-tests": "warn",
    "vitest/no-standalone-expect": "warn",
    "vitest/require-mock-type-parameters": "warn",
    "vitest/require-to-throw-message": "warn",
    "vitest/valid-expect": "warn",
    "vitest/valid-title": "warn"
  },
  "overrides": [
    {
      "files": ["test-setup.mts"],
      "rules": {
        "typescript/no-base-to-string": "warn"
      }
    }
  ]
}
