{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../oxlint.base.config.json", "../../oxlint.strict.config.json"],
  "plugins": ["react"],
  "rules": {
    "react/no-danger-with-children": "error",
    "react/no-namespace": "error",
    "react/no-redundant-should-component-update": "error",
    "react/no-render-return-value": "error",
    "react/no-unsafe": [
      "error",
      {
        "checkAliases": true
      }
    ],
    "react/no-unstable-nested-components": "error",
    "react/self-closing-comp": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "electron",
            "importNames": ["clipboard"],
            "message": "Electron's clipboard module is unavailable in the renderer. Use window.api.clipboard instead."
          },
          {
            "name": "bluebird",
            "message": "Bluebird is being removed. Use native promises."
          },
          {
            "name": "react-markdown",
            "allowTypeImports": true,
            "message": "Render markdown with Markdown (ui/components/prose/markdown). Older call sites styled by their own SCSS use ReactMarkdown from util/react_markdown, which keeps links safe."
          }
        ],
        "patterns": [
          {
            "group": ["**/util/opn", "./opn"],
            "message": "util/opn only backs the deprecated util.opn extension API. Use window.api.shell.openUrl or window.api.shell.openFile instead."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": [
        "src/ExtensionManager.ts",
