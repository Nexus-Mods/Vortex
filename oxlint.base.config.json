{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vitest", "promise", "node", "import", "jsdoc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-array-constructor": "warn",
    "no-case-declarations": "warn",
    "no-empty": "warn",
    "no-fallthrough": "warn",
    "no-prototype-builtins": "warn",
    "no-regex-spaces": "warn",
    "no-useless-assignment": "warn",
    "no-var": "warn",
    "prefer-const": "warn",
    "prefer-rest-params": "warn",
    "prefer-spread": "warn",
    "typescript/ban-ts-comment": "warn",
    "typescript/consistent-type-imports": "warn",
    "typescript/no-empty-object-type": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/no-namespace": "warn",
    "typescript/no-require-imports": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-function-type": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/only-throw-error": "warn",
    "typescript/prefer-promise-reject-errors": "warn",
    "typescript/require-await": "warn",
    "typescript/restrict-plus-operands": "warn"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "out/**", "temp/**", "coverage/**", "build/**"]
}
