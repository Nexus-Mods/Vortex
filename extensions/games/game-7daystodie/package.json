{
  "name": "game-7daystodie",
  "description": "Support for 7 Days to Die",
  "author": "nelson3219 & Senjay",
  "version": "1.1.1",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "game": "7 Days to Die"
  },
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./assets/* dist",
    "build": "node build.mjs && pnpm run _assets && pnpm extractInfo",
    "typecheck": "pnpm exec tsc",
    "lint:strict": "pnpm exec node ../../../scripts/strict-lint.mjs"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*",
    "@types/lodash": "catalog:",
    "@types/react-bootstrap": "catalog:",
    "@types/semver": "catalog:",
    "bluebird": "catalog:",
    "lodash": "catalog:",
    "react": "catalog:",
    "react-bootstrap": "catalog:",
    "react-i18next": "catalog:",
    "react-redux": "catalog:",
    "redux-act": "catalog:",
    "semver": "catalog:",
    "turbowalk": "catalog:",
    "xml2js": "catalog:"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
