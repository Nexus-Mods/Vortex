{
  "name": "game-spyroreignitedtrilogy",
  "version": "1.0.1",
  "description": "Support for Spyro Reignited Trilogy",
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./assets/* dist",
    "build": "node build.mjs && pnpm run _assets && pnpm extractInfo",
    "typecheck": "pnpm exec tsc",
    "lint:strict": "pnpm exec node ../../../scripts/strict-lint.mjs"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "game": "Spyro Reignited Trilogy"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*",
    "bluebird": "catalog:",
    "semver": "catalog:",
    "turbowalk": "catalog:"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
