{
  "name": "game-witcher",
  "version": "0.1.1",
  "description": "Support for The Witcher: Enhanced Edition",
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./assets/* dist",
    "build": "copyfiles -u 1 -f ./src/index.js dist && pnpm run _assets && pnpm extractInfo",
    "typecheck": "pnpm exec tsc",
    "lint:strict": "pnpm exec node ../../../scripts/strict-lint.mjs"
  },
  "author": "Evanito",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "game": "The Witcher"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
