{
  "name": "game-darkestdungeon",
  "version": "1.2.0",
  "description": "Support for Darkest Dungeon",
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./assets/* dist",
    "build": "copyfiles -u 1 -f ./src/*.js dist && pnpm run _assets && pnpm extractInfo",
    "typecheck": "pnpm exec tsc",
    "lint:strict": "pnpm exec node ../../../scripts/strict-lint.mjs"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "game": "Darkest Dungeon"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
