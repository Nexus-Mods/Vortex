{
  "name": "game-witcher3",
  "version": "1.7.5",
  "description": "Support for The Witcher 3",
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./assets/* dist",
    "build": "node build.mjs && pnpm run _assets && pnpm extractInfo",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm exec tsc"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "game": "The Witcher 3"
  },
  "dependencies": {
    "semver": "catalog:"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*",
    "@types/semver": "catalog:",
    "@vortex/extension-test-mocks": "workspace:*"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
