{
  "name": "game-morrowind",
  "version": "1.0.7",
  "description": "Support for The Elder Scrolls III: Morrowind",
  "scripts": {
    "_assets": "copyfiles -u 1 -f ./assets/* dist",
    "build": "node build.mjs && pnpm run _assets && pnpm extractInfo",
    "typecheck": "pnpm exec tsc"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "game": "Morrowind"
  },
  "devDependencies": {
    "@nexusmods/nexus-api": "catalog:",
    "@nexusmods/vortex-api": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-bootstrap": "catalog:",
    "react-i18next": "catalog:",
    "react-redux": "catalog:",
    "winapi-bindings": "catalog:"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
