{
  "name": "gamebryo-bsa-support",
  "version": "0.1.0",
  "description": "Support for (old) Gamebryo data archives",
  "exports": {
    "node": "./out/index.js"
  },
  "scripts": {
    "_native": "node ../copy-native.mjs ./node_modules/bsatk/build/Release/bsatk.node",
    "_build": "node build.mjs && pnpm run _native && pnpm extractInfo",
    "build": "node -e \"if(process.platform==='win32')process.exit(1)\" || (pnpm run _build)",
    "typecheck": "pnpm tsc"
  },
  "author": "Black Tree Gaming Ltd.",
  "license": "GPL-3.0",
  "type": "commonjs",
  "private": true,
  "config": {
    "extensionName": "Gamebryo BSA Support"
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "workspace:*",
    "@types/node": "catalog:",
    "@types/rimraf": "catalog:",
    "bluebird": "catalog:",
    "bsatk": "catalog:",
    "copyfiles": "catalog:",
    "rimraf": "catalog:",
    "tmp": "catalog:"
  },
  "nx": {
    "tags": [
      "vortex:extension"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "typescript",
          "vortex-api"
        ]
      }
    }
  }
}
