# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Scripts (Unix)
*.bash      text eol=lf
*.sh        text eol=lf
*.zsh       text eol=lf

# Scripts (Windows)
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Project files
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.targets   text eol=crlf
*.filters   text eol=crlf
*.vcxitems  text eol=crlf

# Text files where line endings should be preserved
*.patch     -text

# Committed action bundles - GitHub Actions runs these directly, they are never
# reviewed by hand. Collapse them on GitHub and skip the textual diff.
.github/actions/*/dist/** linguist-generated=true -diff

